# Names only. Values never go in git.
#
# Build-time (copy to .env.local for `npm run dev`; Pages → Settings → Variables for production):
NEXT_PUBLIC_DEMO_NUMBER=
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
#
# Pages Functions secrets (production: `npx wrangler pages secret put <NAME>`;
# local `wrangler pages dev`: put them in .dev.vars, which is gitignored):
TURNSTILE_SECRET=
IP_SALT=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DEMO_NUMBER=
PHONE_HASH_KEY=
#
# arkosa-alerts Worker secret (`npx wrangler secret put ALERT_TO -c ../arkosa-alerts/wrangler.toml`):
# ALERT_TO=   a verified Email Routing destination address
