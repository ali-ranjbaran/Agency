# Names only. Values never go in git.
#
# Pages Functions secrets (production: `npx wrangler pages secret put <NAME>`;
# local `wrangler pages dev`: .dev.vars, which is gitignored):
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
ACCESS_EMAILS=
RUNNER_CLIENT_IDS=
PHONE_HASH_KEY=
SNAPSHOT_URL_KEY=
#
# Mac runner: ~/.arkosa/ops-runner.env (created by runner/install-runner.sh), NOT here:
# OPS_URL=  CF_ACCESS_CLIENT_ID=  CF_ACCESS_CLIENT_SECRET=  GOOGLE_PLACES_KEY=  SNAPSHOT_DELAY_SEC=
